<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_alert_before"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_alert_before"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_consecutive"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_consecutive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_rearm"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_rearm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/check_delay_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_delay_enabled" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_delay_threshold"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_delay_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_cooldown"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_cooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_arrival_keywords"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_arrival_keywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_arrival_keywords"
            android:inputType="textMultiLine"
            android:minLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_eta_relative"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_eta_relative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_eta_absolute"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_eta_absolute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_test_delivery"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_test_delivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_test_delivery"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_test_delivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_test_delivery" />

    </LinearLayout>
</ScrollView>
